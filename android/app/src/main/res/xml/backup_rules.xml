<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled in the manifest. These exclusions also protect
     app-private data on Android 11 and earlier backup implementations. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
